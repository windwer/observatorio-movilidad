# Copy to .env and replace ALL placeholders before a container rehearsal.
OBS_DOMAIN=observatorio.example.org
OBS_PUBLIC_READ=1
# Set OBS_PUBLIC_READ=0 for a private reader and fill both reader credentials.
OBS_READER_USERNAME=analista
OBS_READER_PASSWORD=
OBS_ADMIN_USERNAME=administrador
OBS_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_SECRET_24_CHARS
OBS_DATA_RELEASE=gipuzkoa-2026-10-23
OBS_DATA_RELEASE_DIR=C:/replace/with/validated-release
OBS_RATE_LIMIT_PER_MINUTE=3000
OBS_JOB_TIMEOUT_SECONDS=900
OBS_RETENTION_DAYS=30
